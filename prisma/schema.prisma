generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String
  role                    Role                     @default(CUSTOMER)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  loyaltyPoints           Int                      @default(0)
  phone                   String?                  @unique
  twoFactorSecret         String?
  emailVerifiedAt         DateTime?
  addresses               Address[]
  emailVerificationTokens EmailVerificationToken[]
  favorites               Favorite[]
  loginHistory            LoginHistory[]
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]
  reservations            Reservation[]
  reviews                 Review[]
  sessions                Session[]

  @@map("users")
}

model Session {
  id          String    @id
  userId      String
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_history")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  title     String
  address   String
  city      String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  image        String?
  sort         Int                   @default(0)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations CategoryTranslation[]
  products     Product[]

  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  String
  locale      String
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
  @@map("category_translations")
}

model Product {
  id           String               @id @default(cuid())
  categoryId   String
  slug         String               @unique
  basePrice    Decimal              @db.Decimal(10, 2)
  images       String[]
  calories     Int?
  prepTime     Int?
  isAvailable  Boolean              @default(true)
  isFeatured   Boolean              @default(false)
  isVegetarian Boolean              @default(false)
  isSpicy      Boolean              @default(false)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  favorites    Favorite[]
  modifiers    Modifier[]
  orderItems   OrderItem[]
  allergens    ProductAllergen[]
  translations ProductTranslation[]
  variants     ProductVariant[]
  category     Category             @relation(fields: [categoryId], references: [id])
  reviews      Review[]

  @@index([categoryId, isAvailable])
  @@map("products")
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   String
  locale      String
  name        String
  description String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
  @@map("product_translations")
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isDefault  Boolean @default(false)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Modifier {
  id        String  @id @default(cuid())
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

model Allergen {
  id       String            @id @default(cuid())
  code     String            @unique
  products ProductAllergen[]

  @@map("allergens")
}

model ProductAllergen {
  productId  String
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, allergenId])
  @@map("product_allergens")
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String?
  type                OrderType
  status              OrderStatus          @default(PENDING)
  subtotal            Decimal              @db.Decimal(10, 2)
  discount            Decimal              @default(0) @db.Decimal(10, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(10, 2)
  tax                 Decimal              @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  paymentStatus       PaymentStatus        @default(UNPAID)
  paymentProvider     PaymentProvider?
  couponCode          String?
  addressSnapshot     Json?
  phone               String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  trackingTokenHash   String?              @unique
  items               OrderItem[]
  statusHistory       OrderStatusLog[]
  user                User?                @relation(fields: [userId], references: [id])
  paymentTransactions PaymentTransaction[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("orders")
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  orderId               String
  provider              PaymentProvider
  status                PaymentTransactionStatus @default(PENDING)
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @db.VarChar(3)
  idempotencyKey        String                   @unique
  providerSessionId     String?                  @unique
  providerPaymentId     String?                  @unique
  providerTransactionId String?
  failureReason         String?
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, status])
  @@index([providerTransactionId])
  @@map("payment_transactions")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  nameSnapshot String
  variant      String?
  modifiers    Json?
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_logs")
}

model Branch {
  id           String        @id @default(cuid())
  slug         String        @unique
  phone        String?
  address      String?
  lat          Float?
  lng          Float?
  isActive     Boolean       @default(true)
  reservations Reservation[]

  @@map("branches")
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String?
  branchId  String
  date      DateTime
  guests    Int
  status    ReservationStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  branch    Branch            @relation(fields: [branchId], references: [id])
  user      User?             @relation(fields: [userId], references: [id])

  @@index([date])
  @@map("reservations")
}

model Coupon {
  code      String       @id
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)
  minOrder  Decimal?     @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@map("coupons")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@map("reviews")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

model NewsletterSubscriber {
  email     String   @id
  locale    String
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model BlogPost {
  id           String                @id @default(cuid())
  slug         String                @unique
  coverImage   String?
  author       String?
  isPublished  Boolean               @default(false)
  publishedAt  DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations BlogPostTranslation[]
  views        BlogView[]

  @@map("blog_posts")
}

model BlogPostTranslation {
  id             Int      @id @default(autoincrement())
  postId         String
  locale         String
  title          String
  excerpt        String
  content        String
  seoTitle       String?
  seoDescription String?
  post           BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
  @@map("blog_post_translations")
}

model BlogView {
  id        String   @id @default(cuid())
  postId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_views")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentProvider {
  STRIPE
  CASH
  ZARINPAL
  PAYPAL
  ADYEN
  MOLLIE
  MOCK
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

enum DiscountType {
  PERCENT
  FIXED
}
